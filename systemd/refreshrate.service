[Unit]
Description=Set refresh rate on AC/Battery change
After=graphical-session.target
PartOf=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/set-refresh.sh --watch
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
